    "core:window:allow-set-size",
    "opener:default",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "drpc:default",
    "deep-link:default",
    "fs:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
