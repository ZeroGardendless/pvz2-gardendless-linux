{
  "name": "gardendless",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check",
    "preview": "vite --host 127.0.0.1",
    "gpnext:readable": "node scripts/gpnext/Format.mjs && node scripts/gpnext/NameExports.mjs",
    "gpnext:readable:check": "node scripts/gpnext/Format.mjs --check && node scripts/gpnext/NameExports.mjs --check && node scripts/checks/ModuleGraph.mjs",
    "tauri": "node scripts/assets/PatchCocos.mjs && tauri",
    "check": "node scripts/assets/PatchCocos.mjs && node scripts/checks/ModuleGraph.mjs && node scripts/checks/FrameRate.mjs && node scripts/checks/Display.mjs && node scripts/checks/Audio.mjs && node scripts/checks/Features.mjs",
    "assets:optimize": "python scripts/assets/optimize-pngs.py",
    "build:binary": "npm run check && node scripts/native/Build.mjs",
    "assets:bundle": "python scripts/assets/game-bundle.py pack",
    "check:assets": "python scripts/checks/ResourceBundle.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "tauri-plugin-drpc": "^1.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "esbuild": "^0.25.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
